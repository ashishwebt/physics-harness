{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chat.App.API",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/Chat.App.API/bin/Debug/net10.0/Chat.App.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Chat.App.API",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "React",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --host 0.0.0.0",
      "cwd": "${workspaceFolder}/chat-app-ui"
    }
  ],
  "compounds": [
    {
      "name": "fullstack",
      "configurations": [
        "React",
        "Chat.App.API"
      ],
      "stopAll": true
    }
  ]
}
